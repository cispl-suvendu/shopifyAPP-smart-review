<div class="product-reviews">
  <h2>{{ block.settings.heading }}</h2>

  {% if block.settings.show_rating %}
    <p>Rating is enabled</p>
  {% endif %}

  <p>Review Count: {{ block.settings.review_count }}</p>

  <p>Minimum Rating: {{ block.settings.minimum_rating }}</p>

  <p>Product: {{ product.title }}</p>
  <p>Rating: {{ product.metafields.custom.rating.value }}</p>
  {% assign rating = product.metafields.custom.rating.value | round %}

  {% if block.settings.show_rating %}
    <div class="review__rating">
      {% render 'stars', rating: rating %}
    </div>
  {% endif %}
</div>

{% comment %}
  {% assign matched_reviews = 0 %}

    {% for block in block.blocks %}
      {% assign rating = block.settings.review_rating %}

      {% if rating >= block.settings.minimum_rating %}
        {% if matched_reviews < block.settings.review_count %}
          <div class="review">
            <div class="review__name">
              {{ block.settings.customer_name }}
            </div>

            {% if block.settings.show_rating %}
              <div class="review__rating">
                {% render 'stars', rating: rating %}
              </div>
            {% endif %}

            <div class="review__text">
              {{ block.settings.review_text }}
            </div>

            {% assign matched_reviews = matched_reviews | plus: 1 %}

            {% if matched_reviews == block.settings.review_count %}
              {% break %}
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
{% endcomment %}

{% schema %}
{
  "name": "Product Reviews",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Review Count",
      "default": 5
    },
    {
      "type": "number",
      "id": "minimum_rating",
      "label": "Minimum Rating",
      "default": 1
    }
  ]
}
{% endschema %}
